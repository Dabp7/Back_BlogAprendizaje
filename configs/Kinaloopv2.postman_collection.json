{
  "info": {
    "name": "Blog de Aprendizaje — demo",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:3000/kinaloop/v1"
    },
    {
      "key": "postId",
      "value": "670000000000000000000001"
    },
    {
      "key": "adminKey",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Publicaciones",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/post/"
      }
    },
    {
      "name": "Comentarios",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/comment/getCommentsByPost/{{postId}}"
      }
    },
    {
      "name": "Agregar comentario",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"author\": \"Lector Demo\",\n  \"text\": \"Un comentario con datos ficticios\",\n  \"post\": \"{{postId}}\"\n}"
        },
        "url": "{{baseUrl}}/comment/addComment"
      }
    },
    {
      "name": "Actualizar post (solo administración)",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Admin-Key",
            "value": "{{adminKey}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Título de demostración\"\n}"
        },
        "url": "{{baseUrl}}/post/editPost/{{postId}}"
      }
    }
  ]
}
